# OpenWebUI Environment Variables
#
# All API keys and model configs are read from your shell environment
# variables (exported in ~/.bashrc or similar). No manual editing of
# this file is needed — the compose file uses ${VAR:-default}
# substitution to pull values from the environment at container start.
#
# Required (for GPT Researcher):
#   export TAVILY_API_KEY=tvly-...
#
# Optional (for LLM provider connections):
#   export OPENAI_API_KEY=sk-...
#   export ANTHROPIC_API_KEY=sk-ant-...
#   export OPENAI_BASE_URL=https://api.openai.com/v1
#
# Optional (override default models):
#   export FAST_LLM=deepseek-v4-pro:cloud
#   export SMART_LLM=deepseek-v4-pro:cloud
#
# Optional (override Ollama bind address):
#   export OLLAMA_HOST=0.0.0.0
#
# See ~/.os/llm/README.md for the full setup guide.