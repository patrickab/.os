# --- GPT Research (docker compose stack) ---
GPT_RESEARCH_DIR="$HOME/.os/llm/gpt-researcher"

launch-gpt-research() {
    local fast="" smart="" show_help=0 ollama=""

    while [ $# -gt 0 ]; do
        case "$1" in
            --fastllm)   fast="$2"; shift 2 ;;
            --smartllm)  smart="$2"; shift 2 ;;
            --ollama)    ollama="1"; shift ;;
            --help)      show_help=1; shift ;;
            *) echo "Unknown: $1"; return 1 ;;
        esac
    done

    if [ $show_help -eq 1 ]; then
        cat <<'HELP'
launch-gpt-research — start the GPT Researcher MCP server

Usage: launch-gpt-research [OPTIONS]

Reads API keys from your shell environment.
Requires OpenWebUI to be running (base service from ./setup.sh).

Options:
  --fastllm MODEL    Override FAST_LLM (default: deepseek-v4-pro:cloud)
  --smartllm MODEL   Override SMART_LLM (default: deepseek-v4-pro:cloud)
  --ollama           Use host-installed Ollama at localhost:11434
  --help             Show this message

Environment variables:
  TAVILY_API_KEY     Required — Tavily search API key
  OPENAI_API_KEY     OpenAI API key (optional)
  ANTHROPIC_API_KEY  Anthropic API key (optional)
  OPENAI_BASE_URL    LLM endpoint URL (default: https://api.openai.com/v1)
  FAST_LLM           Fast/cheap model (default: deepseek-v4-pro:cloud)
  SMART_LLM          Smart/capable model (default: deepseek-v4-pro:cloud)

Examples:
  launch-gpt-research
  launch-gpt-research --fastllm qwen3:14b --smartllm deepseek-v4-pro:cloud
  launch-gpt-research --ollama --fastllm llama3.2:3b
  FAST_LLM=gpt-4o-mini SMART_LLM=gpt-4o launch-gpt-research
HELP
        return 0
    fi

    [ ! -f "$GPT_RESEARCH_DIR/docker-compose.yml" ] && { echo "ERROR: gpt-research not configured. Run: llm/setup.sh"; return 1; }

    [ -n "$fast" ]  && export FAST_LLM="$fast"
    [ -n "$smart" ] && export SMART_LLM="$smart"
    if [ -n "$ollama" ]; then
        export OPENAI_BASE_URL="${OPENAI_BASE_URL:-http://host.docker.internal:11434/v1}"
        export OPENAI_API_KEY="${OPENAI_API_KEY:-ollama}"
    fi

    echo "==> API key status:"
    [ -n "${TAVILY_API_KEY:-}" ]   && echo "    TAVILY_API_KEY     ✓" || { echo "    TAVILY_API_KEY     ✗ REQUIRED"; return 1; }
    [ -n "${OPENAI_API_KEY:-}" ]   && echo "    OPENAI_API_KEY     ✓" || echo "    OPENAI_API_KEY     - (not set)"
    [ -n "${ANTHROPIC_API_KEY:-}" ] && echo "    ANTHROPIC_API_KEY  ✓" || echo "    ANTHROPIC_API_KEY  - (not set)"
    echo ""
    echo "    FAST_LLM  = ${FAST_LLM:-deepseek-v4-pro:cloud}"
    echo "    SMART_LLM = ${SMART_LLM:-deepseek-v4-pro:cloud}"
    echo "    BASE_URL  = ${OPENAI_BASE_URL:-https://api.openai.com/v1}"
    echo ""

    echo "==> Starting GPT Research stack..."
    docker-compose -f "$GPT_RESEARCH_DIR/docker-compose.yml" up -d

    echo ""
    echo "OpenWebUI:          http://localhost:3000"
    echo "GPT Researcher MCP: http://localhost:8000/mcp"
    echo "Register in OpenWebUI: ~/.os/llm/scripts/register-mcp-openwebui.sh"
    echo ""
}

stop-gpt-research() {
    docker-compose -f "$GPT_RESEARCH_DIR/docker-compose.yml" down
    echo "GPT Research stack stopped."
}

logs-gpt-research() {
    if [ $# -eq 0 ]; then
        docker-compose -f "$GPT_RESEARCH_DIR/docker-compose.yml" logs --tail=100 -f
    else
        docker-compose -f "$GPT_RESEARCH_DIR/docker-compose.yml" logs --tail=100 -f "$@"
    fi
}
