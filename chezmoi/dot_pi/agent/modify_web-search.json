{{- /* chezmoi:modify-template */ -}}
{{- /* pi-web-access config: pin only the keys below, the extension may write its own. */ -}}
{{- $config := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $config = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- /* OpenAI first: used once Pi has a Codex login, skipped until then. Exa (EXA_API_KEY) next, Brave last. */ -}}
{{- $config = setValueAtPath "searchRouting.providers" (list "openai" "exa" "brave") $config -}}
{{- /* Since pi-web-access 0.48 a route needs the failure kinds that move it to the next provider. */ -}}
{{- $config = setValueAtPath "searchRouting.fallbackOn" (list "transient" "quota" "network" "invalid-response" "empty") $config -}}
{{- /* Unchanged input goes back byte for byte: a reformatted copy differs from what the file's owner wrote, and chezmoi then asks on a TTY that chezmoi-watch does not have. */ -}}
{{- if and .chezmoi.stdin (eq (toJson $config) (toJson (fromJson .chezmoi.stdin))) -}}
{{-   .chezmoi.stdin -}}
{{- else -}}
{{-   toPrettyJson $config -}}
{{- end -}}
