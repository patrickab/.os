{{- $p := include (joinPath .chezmoi.sourceDir "../assets/theme/palette.json") | fromJson -}}
{{- $d := $p.dark -}}
{{- $m := $p.markup -}}
{
  "$schema": "https://pi.dev/schemas/theme.schema.json",
  "name": "oh-lucy-evening-custom",
  "appearance": "dark",
  "vars": {
    "bg": {{ $d.bg | quote }},
    "dark": {{ $d.dark | quote }},
    "raised": {{ $d.black1 | quote }},
    "panel": {{ $d.panel | quote }},
    "split": {{ $d.vsplit_bg | quote }},
    "fg": {{ $d.fg | quote }},
    "comment": {{ $d.comment | quote }},
    "gray": {{ $d.non_text | quote }},
    "blue": {{ $d.blue_type | quote }},
    "lightBlue": {{ $d.cyan | quote }},
    "pinkRed": {{ $d.red_key_w | quote }},
    "red": {{ $d.red_err | quote }},
    "green": {{ $d.green | quote }},
    "yellow": {{ $d.yellow | quote }},
    "purple": {{ $d.boolean | quote }},
    "orange": {{ $d.orange_wr | quote }}
  },
  "colors": {
    "accent": "blue",
    "border": {{ $d.popup_back | quote }},
    "borderAccent": "blue",
    "borderMuted": "split",
    "success": "green",
    "error": "red",
    "warning": "yellow",
    "muted": "gray",
    "dim": "comment",
    "text": "fg",
    "thinkingText": "gray",
    "selectedBg": "raised",
    "userMessageBg": "panel",
    "userMessageText": "fg",
    "customMessageBg": "panel",
    "customMessageText": "fg",
    "customMessageLabel": "lightBlue",
    "toolPendingBg": "panel",
    "toolSuccessBg": "panel",
    "toolErrorBg": {{ $d.error_bg | quote }},
    "toolTitle": "lightBlue",
    "toolOutput": "fg",
    "mdHeading": {{ index $d (index $m "heading1") | quote }},
    "mdLink": {{ index $d (index $m "link") | quote }},
    "mdLinkUrl": {{ index $d (index $m "link_url") | quote }},
    "mdCode": {{ index $d (index $m "raw") | quote }},
    "mdCodeBlock": "fg",
    "mdCodeBlockBorder": "split",
    "mdQuote": {{ index $d (index $m "quote") | quote }},
    "mdQuoteBorder": "split",
    "mdHr": "split",
    "mdListBullet": {{ index $d (index $m "list") | quote }},
    "toolDiffAdded": "green",
    "toolDiffRemoved": "pinkRed",
    "toolDiffContext": "gray",
    "syntaxComment": "comment",
    "syntaxKeyword": "purple",
    "syntaxFunction": "green",
    "syntaxVariable": "fg",
    "syntaxString": "green",
    "syntaxNumber": "orange",
    "syntaxType": "blue",
    "syntaxOperator": "lightBlue",
    "syntaxPunctuation": "gray",
    "thinkingOff": "comment",
    "thinkingMinimal": "gray",
    "thinkingLow": "blue",
    "thinkingMedium": "lightBlue",
    "thinkingHigh": "purple",
    "thinkingXhigh": "pinkRed",
    "thinkingMax": "pinkRed",
    "bashMode": "lightBlue"
  },
  "export": {
    "pageBg": {{ $d.bg | quote }},
    "cardBg": {{ $d.black1 | quote }},
    "infoBg": {{ $d.vsplit_bg | quote }}
  }
}
