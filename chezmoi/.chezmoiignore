# Files Omarchy owns and patches in place on update.
# chezmoi must not deploy these, or `chezmoi apply` silently reverts
# upstream improvements delivered by omarchy migrations.
# Personal settings for these live in a *personal.conf sourced afterwards.
#
# tmux.conf is NOT listed here: setup-lite.sh captures Omarchy's copy
# (already patched with the personal.conf source line) back into this repo,
# so chezmoi deploys the exact same tmux.conf on every OS.

# Interactive-learning apps install dependencies on every run.sh, never deploy them or build output.
.agents/skills/interactive-learning/**/node_modules
.agents/skills/interactive-learning/**/dist
.agents/skills/interactive-learning/**/__pycache__
.agents/skills/interactive-learning/**/*.tsbuildinfo

# Keep machine-local monitor layouts and HyprMon preferences out of deployment.
.config/hypr/monitors.lua
.config/hypr/hyprmon.lua
.config/hyprmon/**

# Omarchy's shell settings UI rewrites the bar layout, so it stays machine-local.
.config/omarchy/shell.json

# Repo docs, not config.
.pi/README.md

# The factory plugin's dev files: its tests and their packages run from this repo, hosts get only the plugin.
.pi/agent/extensions/factory/node_modules
.pi/agent/extensions/factory/bun.lock
.pi/agent/extensions/factory/tsconfig.json
.pi/agent/extensions/factory/*.test.ts

# The btw plugin's dev files, same as factory's.
.pi/agent/extensions/btw/node_modules
.pi/agent/extensions/btw/bun.lock
.pi/agent/extensions/btw/tsconfig.json
.pi/agent/extensions/btw/*.test.ts
