# --- OpenWebUI (docker compose) ---
OPENWEBUI_DIR="$HOME/.config/openwebui"

openwebui() {
    docker-compose -f "$OPENWEBUI_DIR/docker-compose.yml" up -d
    echo "OpenWebUI: http://localhost:3000"
}

openwebui-down() {
    docker-compose -f "$OPENWEBUI_DIR/docker-compose.yml" down
}

openwebui-logs() {
    docker-compose -f "$OPENWEBUI_DIR/docker-compose.yml" logs --tail=100 -f
}
