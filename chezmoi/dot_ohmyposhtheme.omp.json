{
  "$schema": "https://raw.githubusercontent.com/JanDeDobbeleer/oh-my-posh/main/themes/schema.json",
  "blocks": [
    {
      "alignment": "left",
      "segments": [
        {
          "foreground": "#EFD472",
          "style": "plain",
          "template": "{{ .UserName }} ",
          "type": "session"
        },
        {
          "foreground": "#8BB8D0",
          "options": {
            "style": "folder"
          },
          "style": "plain",
          "template": "<#DED7D0>in</> {{ .Path }} ",
          "type": "path"
        },
        {
          "foreground": "#BDA9D4",
          "options": {
            "branch_icon": " <#BDA9D4><b>\ue0a0 </b></>"
          },
          "template": "<#DED7D0>on</> {{ .HEAD }}{{ if gt .StashCount 0 }} \ueb4b {{ .StashCount }}{{ end }} ",
          "type": "git"
        }
      ],
      "type": "prompt"
    },
    {
      "alignment": "left",
      "newline": true,
      "segments": [
        {
          "foreground": "#7EC49D",
          "style": "plain",
          "template": "\u276f",
          "type": "text"
        }
      ],
      "type": "prompt"
    }
  ],
  "final_space": true,
  "version": 4
}
