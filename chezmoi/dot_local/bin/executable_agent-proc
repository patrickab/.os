#!/usr/bin/env bash
# agent-proc: observable, self-cleaning tmux processes for agents
set -euo pipefail
S=${AGENT_PROC_SESSION:-$(basename "$(git rev-parse --show-toplevel 2>/dev/null || pwd)")}
TTL=${AGENT_PROC_TTL:-1800} # finished window self-closes after this many seconds if uncollected
T=(tmux ${AGENT_PROC_SOCKET:+-L "$AGENT_PROC_SOCKET"})

win() { "${T[@]}" list-windows -t "=$S" -F '#{window_id} #{window_name}' 2>/dev/null |
  awk -v n="agent-$1" '$2==n{print $1; exit}'; }
need() { id=$(win "$1"); [ -n "$id" ] || { echo "no window agent-$1 in $S" >&2; exit 2; }; }
rc_of() { "${T[@]}" show -wqv -t "$1" @rc 2>/dev/null; }
tail_of() { "${T[@]}" capture-pane -p -t "$1" -S -"$2" | awk 'NF{for(;n>0;n--)print "";print;next}{n++}'; }

cmd=${1:?usage: agent-proc start|wait|logs|stop|ls}; shift
case $cmd in
start) # start <name> <shell command>
  name=${1:?name}; shift
  [ -z "$(win "$name")" ] || { echo "agent-$name already exists in $S" >&2; exit 1; }
  "${T[@]}" has -t "=$S" 2>/dev/null || "${T[@]}" new-session -d -s "$S" -c "$PWD"
  id=$("${T[@]}" new-window -d -P -F '#{window_id}' -t "=$S:" -n "agent-$name" -c "$PWD" bash -c '
    trap : INT
    bash -o pipefail -c "$1"; rc=$?
    printf "\n[process exited %s]\n" "$rc"
    tmux set -w -t "$TMUX_PANE" @rc "$rc"
    sleep "$2"' agent-proc "$*" "$TTL")
  "${T[@]}" set -w -t "$id" @agent 1
  echo "started agent-$name. Watch: tmux attach -t $S" ;;
wait) # wait <name> [timeout_s=600]: on exit print tail, close window, return rc
  need "${1:?name}"; end=$((SECONDS + ${2:-600}))
  until rc=$(rc_of "$id") && [ -n "$rc" ]; do
    [ -n "$(win "$1")" ] || { echo "agent-$1 vanished before reporting" >&2; exit 2; }
    ((SECONDS < end)) || { tail_of "$id" 20; echo "[still running]"; exit 124; }
    sleep 1
  done
  tail_of "$id" "${AGENT_PROC_LINES:-100}"
  "${T[@]}" kill-window -t "$id"; exit "$rc" ;;
logs) # logs <name> [lines=100]
  need "${1:?name}"; tail_of "$id" "${2:-100}" ;;
stop) # stop <name>: C-c, grace 3s, close window
  need "${1:?name}"; "${T[@]}" send-keys -t "$id" C-c
  for _ in {1..3}; do [ -n "$(rc_of "$id")" ] && break; sleep 1; done
  tail_of "$id" 20; "${T[@]}" kill-window -t "$id" ;;
ls)
  "${T[@]}" list-windows -t "=$S" -f '#{@agent}' -F '#{window_name} #{?#{@rc},exited #{@rc},running}' 2>/dev/null || true ;;
*) echo "unknown: $cmd" >&2; exit 64 ;;
esac
