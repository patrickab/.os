

alias ls='eza -l --no-user --no-permissions --no-filesize --group-directories-first --icons=auto'
alias tree='ls --tree -I "__pycache__"'
alias python='python3'

# Restrict GPU access
alias code="code --disable-gpu"
alias obsidian="obsidian --disable-gpu"

cd ()
{
    builtin cd "$@";
    ls
}

search ()
{
    if [ -z "$1" ]; then
        echo "Usage: ${FUNCNAME[0]} '<search_string>'" 1>&2;
        return 1;
    fi;
    if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        git ls-files --cached --others --exclude-standard -z | xargs -0r grep --color=auto -nH -I -- "$1"
    else
        grep --color=auto -rnH -I -- "$1" .
    fi
}

function yy() {
        local tmp="$(mktemp -t "yazi-cwd.XXXXXX")"
        yazi "$@" --cwd-file="$tmp"
        if cwd="$(cat -- "$tmp")" && [ -n "$cwd" ] && [ "$cwd" != "$PWD" ]; then
                cd -- "$cwd"
        fi
        rm -f -- "$tmp"
}
