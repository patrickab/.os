{{- /* chezmoi:modify-template */ -}}
{{- /* VS Code and Omarchy's theme switch rewrite settings.json, so only pin the keys below and keep everything else. */ -}}
{{- $settings := dict -}}
{{- if .chezmoi.stdin -}}
{{-   $settings = fromJson .chezmoi.stdin -}}
{{- end -}}
{{- $pinned := `{
  "github.copilot.nextEditSuggestions.enabled": true,
  "[cpp]": {
    "editor.wordBasedSuggestions": "off",
    "editor.semanticHighlighting.enabled": true,
    "editor.stickyScroll.defaultModel": "foldingProviderModel",
    "editor.suggest.insertMode": "replace"
  },
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false
  },
  "git.autofetch": true,
  "terminal.integrated.gpuAcceleration": "off",
  "jupyter.widgetScriptSources": ["jsdelivr.com", "unpkg.com"]
}` | fromJson -}}
{{- range $key, $value := $pinned -}}
{{-   $_ := set $settings $key $value -}}
{{- end -}}
{{- toPrettyJson "    " $settings }}
