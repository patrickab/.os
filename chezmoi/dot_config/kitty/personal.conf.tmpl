# Personal kitty overrides — included by omarchy's kitty.conf (later directives win)

# Font
font_family JetBrainsMono Nerd Font Thin Italic
bold_font JetBrainsMono Nerd Font Bold
italic_font JetBrainsMono Nerd Font Thin Italic
bold_italic_font JetBrainsMono Nerd Font Bold Italic

# Window
window_padding_width 2

# Keybindings
map ctrl+tab next_window
map kitty_mod+tab previous_window

# Tab bar styling
tab_bar_style fade

# Transparency — kitty must declare its own alpha < 1 for Hyprland's blur
# to render behind it at all; a windowrule opacity alone doesn't do it.
# `blur_radius` was a leftover from a WezTerm config (not a real kitty
# option, silently ignored) — kitty's actual native compositor blur option
# is background_blur. Values use the shared glass settings.
background_opacity {{ .glass.kitty.backgroundOpacity }}
dynamic_background_opacity yes
background_blur {{ .glass.kitty.backgroundBlur }}

# Scrollback
scrollback_lines 2000

# Wez theme (overrides omarchy theme colors)
foreground            #b3b3b3
background            #000000
selection_background  #4c52f8
selection_foreground  #000000
color0                #000000
color8                #555555
color1                #cc5555
color9                #ff5555
color2                #55cc55
color10               #55ff55
color3                #cdcd55
color11               #ffff55
color4                #5455cb
color12               #5555ff
color5                #cc55cc
color13               #ff55ff
color6                #7acaca
color14               #55ffff
color7                #cccccc
color15               #ffffff
active_border_color   #05f721

# must come after the colour block above
cursor                       #AEAFAD
cursor_text_color            background
cursor_trail                 3
cursor_trail_decay           0.1 0.4
cursor_trail_start_threshold 2
