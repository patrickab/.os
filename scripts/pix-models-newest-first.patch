+/** Name order with the first version number descending: "opus-5.5" and "opus-5.5:batch" before "opus-5", then "opus-4.8". */
+function compareNewestFirst(a: string, b: string): number {
+	const split = (name: string) => {
+		const match = /^(\D*)(\d+(?:\.\d+)*)?(.*)$/s.exec(name) as RegExpExecArray;
+		return { prefix: match[1], version: (match[2] ?? "").split(".").filter(Boolean).map(Number), suffix: match[3] };
+	};
+	const x = split(a);
+	const y = split(b);
+	const byPrefix = x.prefix.localeCompare(y.prefix);
+	if (byPrefix !== 0) return byPrefix;
+	for (let i = 0; i < Math.max(x.version.length, y.version.length); i++) {
+		const diff = (y.version[i] ?? 0) - (x.version[i] ?? 0);
+		if (diff !== 0) return diff;
+	}
+	return x.suffix.localeCompare(y.suffix);
+}
